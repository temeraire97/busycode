{
  "name": "busycode-cli",
  "version": "0.1.0",
  "private": false,
  "description": "BusyCode terminal-native CLI simulator",
  "type": "module",
  "bin": {
    "busycode": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "ink": "^7.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  }
}
